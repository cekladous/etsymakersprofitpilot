{
  "name": "EtsyConnection",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID that owns this Etsy connection"
    },
    "shop_id": {
      "type": "string",
      "description": "Etsy shop ID this connection belongs to"
    },
    "shop_name": {
      "type": "string",
      "description": "Etsy shop name (for display)"
    },
    "access_token": {
      "type": "string",
      "description": "Etsy OAuth access token for this seller"
    },
    "refresh_token": {
      "type": "string",
      "description": "Etsy OAuth refresh token for this seller"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Access token expiry timestamp"
    },
    "scopes": {
      "type": "string",
      "description": "Space-separated authorized scopes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disconnected"
      ],
      "default": "pending",
      "description": "Connection lifecycle status"
    },
    "oauth_state": {
      "type": "string",
      "description": "Random nonce used to verify the OAuth callback belongs to this user"
    },
    "code_verifier": {
      "type": "string",
      "description": "PKCE code_verifier stored during the pending OAuth start"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the connection was activated"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful order import timestamp"
    },
    "last_imported_count": {
      "type": "number",
      "default": 0,
      "description": "Number of new orders imported on the last sync"
    },
    "last_error": {
      "type": "string",
      "description": "Last sync error message (empty when successful)"
    }
  },
  "required": [
    "owner_user_id"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}