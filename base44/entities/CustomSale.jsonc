{
  "name": "CustomSale",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID that owns this record"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Sale date"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor/customer name"
    },
    "description": {
      "type": "string",
      "description": "Sale description"
    },
    "payment_source": {
      "type": "string",
      "description": "Revenue source (Cash, Check, Zelle, Venmo, Square, PayPal, Etsy, Squarespace, Other)"
    },
    "pre_tax_amount": {
      "type": "number",
      "description": "Pre-sales tax amount"
    },
    "sales_tax_collected": {
      "type": "number",
      "default": 0,
      "description": "Sales tax collected"
    },
    "gross_sale": {
      "type": "number",
      "description": "Total sale amount (pre_tax + sales_tax)"
    },
    "shipping_or_postage_cost": {
      "type": "number",
      "default": 0,
      "description": "Shipping or postage cost for this sale"
    },
    "notes": {
      "type": "string"
    },
    "square_payment_id": {
      "type": "string",
      "description": "Square payment ID this sale was imported from (upsert key). Adjustment rows use <payment id>#adj."
    },
    "square_order_id": {
      "type": "string",
      "description": "Square order ID behind this payment"
    },
    "square_invoice_number": {
      "type": "string",
      "description": "Square invoice number, when the payment came from an invoice"
    },
    "square_payment_method": {
      "type": "string",
      "description": "How Square collected the money: card, cash or external"
    },
    "linked_etsy_order_id": {
      "type": "string",
      "description": "Etsy order this Square record is linked to (set on adjustment rows)"
    },
    "is_square_adjustment": {
      "type": "boolean",
      "default": false,
      "description": "True when this row only records the amount Square collected above the linked Etsy order total"
    }
  },
  "required": [
    "owner_user_id",
    "date",
    "gross_sale"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}