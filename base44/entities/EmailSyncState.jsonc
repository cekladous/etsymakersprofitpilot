{
  "name": "EmailSyncState",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID that owns this record"
    },
    "provider": {
      "type": "string",
      "enum": [
        "gmail",
        "outlook"
      ],
      "description": "Email provider"
    },
    "connector_id": {
      "type": "string",
      "description": "Workspace connector ID this sync state tracks (supports multiple accounts per provider)"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful sync timestamp"
    },
    "processed_message_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Recently processed message IDs for dedupe (capped)"
    },
    "last_status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "running"
      ],
      "default": "success"
    },
    "last_error": {
      "type": "string"
    },
    "last_imported_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "owner_user_id",
    "provider"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}