{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID that owns this record"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Transfer date"
    },
    "type": {
      "type": "string",
      "enum": [
        "owner_transfer",
        "etsy_deposit"
      ],
      "description": "Transfer type"
    },
    "amount": {
      "type": "number",
      "description": "Transfer amount"
    },
    "notes": {
      "type": "string",
      "description": "Transfer notes"
    },
    "voided": {
      "type": "boolean",
      "default": false,
      "description": "True when this row was not a real deposit (e.g. order total did not cover Etsy fees). Kept for history, excluded from totals."
    },
    "void_reason": {
      "type": "string",
      "description": "Why this transfer was voided"
    }
  },
  "required": [
    "owner_user_id",
    "date",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}