{
  "name": "ReceiptSupplier",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User ID that owns this record"
    },
    "name": {
      "type": "string",
      "description": "Friendly supplier name"
    },
    "match_value": {
      "type": "string",
      "description": "Sender email address or domain to match against incoming receipts"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "name",
    "match_value"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}